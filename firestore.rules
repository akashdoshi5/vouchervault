rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaultGroups/{groupId} {
      // Rule 18: Max members 5, code hidden, only group members can read/write group data
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        (request.method == 'create' && request.auth.uid in request.resource.data.memberUids)
      );
    }
    match /users/{userId}/vouchers/{voucherId} {
      // Rule 18: Group members can read (but clients hide codes based on other logic). Owner can read.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid in resource.data.sharedWith
      );
      // Let owner write. Also anyone authorized via sharedWith can write (Rule 22 locking, etc.)
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid in resource.data.sharedWith ||
        (request.method == 'create' && (request.auth.uid == userId || request.auth.uid in request.resource.data.sharedWith))
      );
    }
    match /users/{userId}/deletedVouchers/{voucherId} {
      // Zombie guard collections
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}