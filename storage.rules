rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only allow users to upload images to their own directory.
    // Allow any authenticated user to read images (needed for shared items displaying brand logos).
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
